# Copy this file to ".env" and fill in your own values.
# Then restart the development server (npm run dev).

# Optional Supabase project variables
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Razorpay client key (sandbox)
# not required if you hardcode in code or rely on default test key
VITE_RAZORPAY_KEY_ID=rzp_test_SM1XYnIs87t6S3

# If your backend runs on a different host/port, point the socket
# client and order-create function to it:
VITE_API_URL=http://localhost:4000

